# .env.local.example
#
# This file shows which environment variables the app needs to run.
# Copy this file to .env.local and fill in the real values from your Supabase project.
#
# IMPORTANT: Never commit .env.local to git — it contains secrets.
# This example file (with no real values) IS safe to commit.
#
# Where to find these values:
#   1. Go to https://supabase.com and open your project
#   2. Navigate to Project Settings → API
#   3. Copy the "Project URL" and "anon / public" key

# The URL of your Supabase project (e.g. https://xyzxyzxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The public anonymous key for your Supabase project
# This key is safe to expose in the browser — it has limited access controlled by RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The secret service role key — NEVER expose this in the browser or commit .env.local.
# Required for server-side admin operations that bypass RLS (e.g. QA tests, seed scripts).
# Find it in: Supabase dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- Issue #84: provider-assigned email notification (Resend) ---------------
#
# The secret Resend API key — NEVER expose this in the browser or commit
# .env.local. Only read server-side, in app/api/bookings/notify-provider-
# assigned/route.ts (via lib/notifications/resend.ts). Not prefixed with
# NEXT_PUBLIC_, so Next.js will never inline it into a client bundle.
# Find it in: https://resend.com dashboard → API Keys.
# If this is unset, the email send is skipped and logged — the booking
# save is never affected either way.
RESEND_API_KEY=

# Optional — the "From" address used for the provider-assigned email, e.g.
# "Book_it <noreply@yourdomain.com>" once a domain is verified in Resend.
# Defaults to Resend's shared sandbox sender ("onboarding@resend.dev") if
# unset, which can only deliver to the Resend account owner's own address.
RESEND_FROM_EMAIL=
