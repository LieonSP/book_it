# .env.local.example
#
# This file shows which environment variables the app needs to run.
# Copy this file to .env.local and fill in the real values from your Supabase project.
#
# IMPORTANT: Never commit .env.local to git — it contains secrets.
# This example file (with no real values) IS safe to commit.
#
# Where to find these values:
#   1. Go to https://supabase.com and open your project
#   2. Navigate to Project Settings → API
#   3. Copy the "Project URL" and "anon / public" key

# The URL of your Supabase project (e.g. https://xyzxyzxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# The public anonymous key for your Supabase project
# This key is safe to expose in the browser — it has limited access controlled by RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=
